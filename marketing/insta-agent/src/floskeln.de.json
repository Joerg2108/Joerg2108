  "structures": [
    {
      "id": "rocket",
      "regex": "[\\U0001F680\\U0001F525\\U0001F4A1\\u2728\\U0001F3AF]",
      "name": "Raketen-/Feuer-/Glühbirnen-Emoji",
      "fix": "Höchstens ein Emoji, und nicht eines dieser fünf (🚀🔥💡✨🎯)."
    },
    {
      "id": "hashtag-wall",
      "regex": "(?:#\\w+[ \\t]*){5,}",
      "name": "Hashtag-Wand",
      "fix": "Hashtags gehören ans Ende oder in den ersten Kommentar, nicht als Wand in den Text."
    },
    {
      "id": "emoji-bullets",
      "regex": "(?m)^\\s*[\\U0001F300-\\U0001FAFF✅➡⬅✔✨]\\s*\\S",
      "name": "Emoji-Aufzählung",
      "fix": "Bindestrich oder Zeilenumbruch statt Emoji-Aufzählung. Wirkt sonst wie eine Vorlage."
    },
    {
      "id": "caps-shout",
      "regex": "\\b[A-Z]{3,}\\b(?:\\s+\\b[A-Z]{3,}\\b){2,}",
      "name": "Mehrere Wörter in Großbuchstaben",
      "fix": "Großbuchstaben sind ein Lautstärkeregler. Höchstens ein Wort."
    },
    {
      "id": "nicht-nur-sondern",
      "regex": "(?i)\\bnicht nur\\b[^.!?\\n]{2,80}\\bsondern\\b",
      "name": "„nicht nur X, sondern auch Y“",
      "fix": "Sag das eine, was du wirklich meinst. Oder zwei Sätze daraus machen."
    },
    {
      "id": "es-geht-nicht-um",
      "regex": "(?i)\\b(?:es|das) geht (?:hier )?nicht (?:nur )?um [^.!?\\n]{2,60}[.!,–-]\\s*(?:es geht um|sondern um|sondern)\\b",
      "name": "„Es geht nicht um X. Es geht um Y.“",
      "fix": "Mit Y anfangen. Die Umkehrung ist das Erkennungszeichen."
    },
    {
      "id": "ist-nicht-ist",
      "regex": "(?i)\\b(?:das|es) ist nicht (?:nur |einfach )?[^.!?\\n]{2,50}[.,–-]\\s*(?:es|das) ist\\b",
      "name": "„Das ist nicht X – das ist Y“",
      "fix": "Direkt sagen, was es ist."
    },
    {
      "id": "enthuellung",
      "regex": "(?im)^\\s*(?:das ergebnis|das beste daran|der clou|der haken|die lösung|und jetzt kommt's|und das beste)\\?\\s*$",
      "name": "Inszenierte Enthüllung („Das Ergebnis?“)",
      "fix": "Die Antwort direkt in den Satz schreiben statt eine Pause zu inszenieren."
    },
    {
      "id": "dreierkette",
      "regex": "(?i)\\b[\\wäöüß]+, [\\wäöüß]+ und [\\wäöüß]+\\.",
      "name": "Dreierkette „X, Y und Z.“",
      "fix": "Zwei oder vier Dinge. Drei ist der Standard-Rhythmus von KI-Texten."
    },
    {
      "id": "fazit",
      "regex": "(?im)^\\s*(?:fazit|zusammenfassend|abschließend|zum schluss)\\b",
      "name": "Fazit-Absatz",
      "fix": "Ein Post braucht kein Fazit. Mit der stärksten Aussage aufhören."
    },
    {
      "id": "frage-koeder",
      "regex": "(?im)(?:wer kennt das\\?|geht es nur mir so\\?|wer noch\\?|seht ihr das auch so\\?|stimmt's\\?)\\s*$",
      "name": "Allgemeiner Kommentar-Köder",
      "fix": "Eine Frage stellen, die nur du stellen kannst, zum konkreten Inhalt darüber."
    },
    {
      "id": "nicht-scrollen",
      "regex": "(?im)^\\s*(?:hör auf zu scrollen|stopp[,!]? nicht (?:weiter)?scrollen|scroll nicht weiter)\\b",
      "name": "„Hör auf zu scrollen“",
      "fix": "Der Scroll-Stopper muss die Aussage selbst sein. Um Aufmerksamkeit bitten zeigt, dass man sie nicht verdient hat."
    },
    {
      "id": "in-diesem-video",
      "regex": "(?i)\\b(?:in diesem (?:video|reel|beitrag|post)|heute zeige ich (?:dir|euch|ihnen)|ich zeige (?:dir|euch|ihnen) heute)\\b",
      "name": "Vorrede („In diesem Video zeige ich …“)",
      "fix": "Streichen und mit der Pointe anfangen. Die ersten zwei Sekunden entscheiden."
    },
    {
      "id": "als-ki",
      "regex": "(?i)\\bals (?:eine )?(?:ki|künstliche intelligenz|sprachmodell)\\b",
      "name": "„Als KI …“",
      "fix": "Den Satz löschen."
    },
    {
      "id": "gedankenstrich-flut",
      "regex": "(?s)\\A(?=(?:.*?\\s–\\s){4})",
      "name": "Viele Gedankenstriche (4+)",
      "fix": "Gedankenstriche sind korrekt, aber KI-Texte übertreiben sie. Zwei pro Text reichen, Rest durch Punkt oder Komma ersetzen."
    },
    {
      "id": "ausrufe-flut",
      "regex": "(?s)!{2,}|\\A(?=(?:.*?!){4})",
      "name": "Zu viele Ausrufezeichen",
      "fix": "Höchstens eins. Begeisterung entsteht durch Inhalt, nicht durch Satzzeichen."
    }
  ]
}