# Kopieren nach .env und ausfüllen:  cp .env.beispiel .env
# Die Datei .env enthält Geheimnisse – niemals ins Git oder weitergeben!

# --- Claude (Texte) ------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
# INSTA_AGENT_MODEL=claude-opus-5-5

# --- Instagram -----------------------------------------------------------------
# Langlebiges Token aus der Meta-App (README → „Instagram einrichten“). Wird automatisch erneuert.
INSTAGRAM_ACCESS_TOKEN=IGAA...
# Optional – wird sonst automatisch ermittelt:
# INSTAGRAM_USER_ID=
# INSTAGRAM_API_VERSION=v24.0

# --- Bild-Hosting (Instagram holt die Bilder von einer öffentlichen URL) --------
# Variante A: eigener Server mit Caddy/nginx
BILD_HOSTING=ordner
BILD_ORDNER=/var/lib/insta-agent/public
BILD_BASIS_URL=https://office.joerg-noack.com/insta

# Variante B: Cloudflare R2 / S3 (öffentlicher Bucket oder eigene Domain davor)
# BILD_HOSTING=s3
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=insta-bilder
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# BILD_BASIS_URL=https://pub-xxxxxxxx.r2.dev

# --- Verhalten -----------------------------------------------------------------
STORIES_PRO_TAG=2
# Unter dieser Note (1–10) wird NICHT veröffentlicht, sondern nur ein Entwurf gespeichert
MINDESTNOTE=8

# Optional: Push-Nachricht aufs Handy nach jedem Lauf (App „ntfy“, Kanalname geheim halten)
# BENACHRICHTIGUNG_URL=https://ntfy.sh/joerg-insta-<zufall>
