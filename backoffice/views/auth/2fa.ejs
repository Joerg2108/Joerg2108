<% if (typeof error !== 'undefined') { %><div class="alert error"><%= error %></div><% } %>
<p class="muted">Gib den 6-stelligen Code aus deiner Authenticator-App ein.</p>
<form method="post" action="/login/2fa">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <%- h.input('code', 'Bestätigungscode', '', { inputmode: 'numeric', pattern: '[0-9 ]{6,7}', autocomplete: 'one-time-code', required: true, autofocus: true, maxlength: 7 }) %>
  <button class="btn primary">Bestätigen</button>
  <p class="small" style="text-align:center;margin:0"><a href="/login">Abbrechen</a></p>
</form>
