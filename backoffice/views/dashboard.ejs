<div class="page-head">
  <div>
    <h1>Übersicht</h1>
    <div class="sub"><%= new Date().toLocaleDateString('de-DE', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric', timeZone: 'Europe/Berlin' }) %> · <%= user.name %></div>
  </div>
  <div class="actions">
    <% if (can('sales')) { %>
      <a class="btn" href="/belege/angebote/neu"><%- h.icon('plus') %> Angebot</a>
      <a class="btn primary" href="/belege/rechnungen/neu"><%- h.icon('plus') %> Rechnung</a>
    <% } else { %>
      <a class="btn primary" href="/aufgaben/neu"><%- h.icon('plus') %> Aufgabe</a>
    <% } %>
  </div>
</div>

<% if (can('sales')) { %>
<div class="kpis">
  <a class="kpi <%= kpi.overdue.n ? 'warn' : '' %>" href="/belege/mahnwesen"><span>Überfällig</span><strong><%= h.eur(kpi.overdue.s) %></strong><small><%= kpi.overdue.n %> Rechnung<%= kpi.overdue.n === 1 ? '' : 'en' %> · zum Mahnwesen</small></a>
  <a class="kpi" href="/belege/rechnungen?status=offen"><span>Offene Posten</span><strong><%= h.eur(kpi.open.s) %></strong><small><%= kpi.open.n %> Rechnung<%= kpi.open.n === 1 ? '' : 'en' %> warten auf Zahlung</small></a>
  <a class="kpi" href="/belege/angebote?status=versendet"><span>Offene Angebote</span><strong><%= h.eur(kpi.quotesOpen.s) %></strong><small><%= kpi.quotesOpen.n %> Angebot<%= kpi.quotesOpen.n === 1 ? '' : 'e' %> in Arbeit oder beim Kunden</small></a>
  <a class="kpi" href="/berichte"><span>Umsatz diesen Monat</span><strong><%= h.eur(kpi.revenueMonth) %></strong><small>netto · zu den Berichten</small></a>
</div>
<% } %>

<div class="grid side">
  <div>
    <% if (can('sales') || can('leads')) { %>
    <section class="card flush" aria-labelledby="todo-h">
      <div class="card-head"><h2 id="todo-h">Heute zu tun</h2><span class="muted small"><%= todo.length ? todo.length + ' offene' + (todo.length === 1 ? 'r Vorgang' : ' Vorgänge') : '' %></span></div>
      <% if (!todo.length) { %>
        <div class="empty"><strong>Alles erledigt.</strong><br>Keine neuen Anfragen, keine offenen Entwürfe, nichts überfällig.</div>
      <% } else { %>
      <ul class="worklist">
        <% for (const t of todo) { %>
        <li>
          <a href="<%= t.href %>">
            <span class="dot <%= t.tone %>" aria-hidden="true"></span>
            <span class="wl-main"><span class="wl-kind"><%= t.kind %></span><strong><%= t.title %></strong><small><%= t.sub %></small></span>
            <span class="wl-amount"><%= t.amount ? h.eur(t.amount) : '' %></span>
            <span class="btn sm wl-action"><%= t.action %></span>
          </a>
        </li>
        <% } %>
      </ul>
      <% } %>
    </section>
    <% } %>

    <%- include('demo-tour') %>
  </div>

  <div>
    <% if (myShifts.length) { %>
    <div class="card"><div class="card-head"><h2>Meine nächsten Schichten</h2><a href="/dienstplan">Dienstplan</a></div>
      <ul class="plain-list"><% for (const sh of myShifts) { %><li><strong><%= h.date(sh.starts_at) %></strong> <%= sh.starts_at.slice(11) %>–<%= sh.ends_at.slice(11) %><small><%= sh.title %><%= sh.location ? ' · ' + sh.location : '' %></small></li><% } %></ul>
    </div>
    <% } %>
    <% if (roster && (roster.open || roster.expiring.length)) { %>
    <div class="card"><div class="card-head"><h2>Einsatzplanung</h2><a href="/dienstplan">Dienstplan</a></div>
      <ul class="plain-list">
        <% if (roster.open) { %><li><a href="/dienstplan"><strong><%= roster.open %> offene Schicht<%= roster.open === 1 ? '' : 'en' %></strong></a><small>in den nächsten 14 Tagen zu besetzen</small></li><% } %>
        <% for (const q of roster.expiring) { %><li><a href="/personal/<%= q.staff_id %>"><%= q.first_name %> <%= q.last_name %></a><small><%= q.type_name %> <%= q.expires_at < today ? 'abgelaufen' : 'gültig bis ' + h.date(q.expires_at) %></small></li><% } %>
      </ul>
    </div>
    <% } %>
    <div class="card">
      <div class="card-head"><h2>Meine Aufgaben</h2><a class="btn sm" href="/aufgaben/neu" aria-label="Aufgabe anlegen"><%- h.icon('plus') %></a></div>
      <% if (!tasks.length) { %><p class="muted">Keine offenen Aufgaben.</p><% } %>
      <ul class="plain-list">
      <% for (const t of tasks) { %>
        <li class="task-row">
          <form method="post" action="/aufgaben/<%= t.id %>/status"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="status" value="erledigt"><button class="check-btn" title="Als erledigt markieren" aria-label="„<%= t.title %>“ als erledigt markieren"></button></form>
          <div><a href="/aufgaben/<%= t.id %>/bearbeiten"><%= t.title %></a>
            <small><% if (t.due_date) { %><span class="<%= t.due_date < today ? 'neg' : '' %>">fällig <%= h.date(t.due_date) %></span><%= t.project_name ? ' · ' : '' %><% } %><%= t.project_name || '' %></small></div>
          <%- ['hoch', 'dringend'].includes(t.priority) ? h.badge(t.priority) : '' %>
        </li>
      <% } %>
      </ul>
    </div>
    <% if (appointments.length) { %>
    <div class="card">
      <div class="card-head"><h2>Termine diese Woche</h2><a href="/kalender">Kalender</a></div>
      <ul class="plain-list">
      <% for (const a of appointments) { %>
        <li><a href="/kalender/<%= a.id %>/bearbeiten"><%= a.title %></a><small><%= h.date(a.starts_at) %><%= a.all_day ? ' (ganztägig)' : ', ' + a.starts_at.slice(11, 16) + ' Uhr' %><%= a.location ? ' · ' + a.location : '' %></small></li>
      <% } %>
      </ul>
    </div>
    <% } %>
  </div>
</div>
