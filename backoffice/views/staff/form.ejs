<div class="page-head"><h1><%= title %></h1>
<% if (st.id) { %><form method="post" action="/personal/<%= st.id %>/loeschen" data-confirm="Mitarbeiter löschen?"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn danger">Löschen</button></form><% } %></div>
<form method="post" action="<%= st.id ? '/personal/' + st.id : '/personal' %>" class="card form-grid">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <%- h.input('first_name', 'Vorname', st.first_name, { required: true, cls: 'span-4' }) %>
  <%- h.input('last_name', 'Nachname', st.last_name, { required: true, cls: 'span-4' }) %>
  <%- h.input('personnel_no', 'Personalnummer', st.personnel_no, { cls: 'span-4' }) %>
  <%- h.input('email', 'E-Mail (für Dienstplan-Versand)', st.email, { type: 'email', cls: 'span-4' }) %>
  <%- h.input('phone', 'Telefon', st.phone, { type: 'tel', cls: 'span-4' }) %>
  <%- h.input('bewacher_id', 'Bewacher-ID (Bewacherregister)', st.bewacher_id, { cls: 'span-4' }) %>
  <%- h.select('employment', 'Beschäftigung', st.employment, EMPLOYMENT, { cls: 'span-4' }) %>
  <%- h.input('weekly_hours', 'Soll-Stunden / Woche', h.num(st.weekly_hours), { inputmode: 'decimal', cls: 'span-2' }) %>
  <%- h.input('hourly_wage', 'Stundenlohn €', st.hourly_wage ? h.moneyInput(st.hourly_wage) : '', { inputmode: 'decimal', cls: 'span-2', hint: 'für Lohnvorschau' }) %>
  <%- h.select('color', 'Farbe im Plan', st.color, { blau: 'Blau', gruen: 'Grün', rot: 'Rot', orange: 'Orange', lila: 'Lila', grau: 'Grau' }, { cls: 'span-2' }) %>
  <%- h.select('user_id', 'Back-Office-Zugang', st.user_id, users.map((u) => [u.id, u.name]), { empty: '– keiner –', cls: 'span-2', hint: 'sieht eigene Schichten' }) %>
  <%- h.input('notes', 'Notizen', st.notes, { type: 'textarea', cls: 'span-12' }) %>
  <div class="span-12"><%- h.checkbox('active', 'Aktiv (wird im Dienstplan angezeigt)', st.active) %></div>
  <div class="span-12 sticky-actions"><a class="btn" href="<%= st.id ? '/personal/' + st.id : '/personal' %>">Abbrechen</a><button class="btn primary">Speichern</button></div>
</form>
