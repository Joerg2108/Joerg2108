<%# Leistungsübersicht neben der Anmeldung – nur in der Demo %>
<aside class="auth-features">
  <p class="auth-features-kicker">Back Office für Dienstleistungsunternehmen</p>
  <h2>Alles, was Ihr Büro braucht – in einer Software.</h2>
  <ul class="auth-features-list">
    <li><%- h.icon('inbox') %><div><strong>Anfragen &amp; Kunden</strong><span>Website-Kontaktformular landet direkt im Vertriebs-Board, Kundenkartei mit Historie.</span></div></li>
    <li><%- h.icon('euro') %><div><strong>Angebote, Aufträge &amp; Rechnungen</strong><span>E-Rechnung (XRechnung), GiroCode, Festschreibung nach GoBD.</span></div></li>
    <li><%- h.icon('repeat') %><div><strong>Abos &amp; Verträge</strong><span>Wiederkehrende Rechnungen für Wartungs- und Betreuungsverträge.</span></div></li>
    <li><%- h.icon('bell') %><div><strong>Mahnwesen</strong><span>Überfällige Rechnungen erkennen, 3 Mahnstufen mit Gebühren.</span></div></li>
    <li><%- h.icon('folder') %><div><strong>Projekte, Aufgaben &amp; Kalender</strong><span>Budget, Stunden und Termine je Projekt im Blick.</span></div></li>
    <li><%- h.icon('clock') %><div><strong>Zeiterfassung</strong><span>Arbeitszeiten erfassen und direkt abrechnen.</span></div></li>
    <li><%- h.icon('calendar') %><div><strong>Dienstplan &amp; Einsatzplanung</strong><span>Prüft Ruhezeiten, Urlaub und abgelaufene Qualifikationen.</span></div></li>
    <li><%- h.icon('activity') %><div><strong>Stundenauswertung</strong><span>Nacht-, Sonn- und Feiertagszuschläge, CSV für die Lohnbuchhaltung.</span></div></li>
    <li><%- h.icon('receipt') %><div><strong>Ausgaben &amp; Belege</strong><span>Belege hochladen, Lieferanten, EÜR und Umsatzsteuer-Übersicht.</span></div></li>
    <li><%- h.icon('chart') %><div><strong>Berichte &amp; DATEV</strong><span>Auswertungen und DATEV-Export für den Steuerberater.</span></div></li>
    <li><%- h.icon('file') %><div><strong>Dateien &amp; Website-Anbindung</strong><span>Dokumentenablage, Leistungskatalog und API für Ihre Website.</span></div></li>
    <li><%- h.icon('shield') %><div><strong>Rollen &amp; Datenschutz</strong><span>Rechteverwaltung, Zwei-Faktor-Login, Protokoll und Backups.</span></div></li>
  </ul>
  <p class="auth-features-usp">Einmalpreis statt Abo · beliebig viele Nutzer · läuft auf Ihrem eigenen Server</p>
</aside>
