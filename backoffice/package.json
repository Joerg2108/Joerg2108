{
  "name": "noack-backoffice",
  "version": "1.0.0",
  "description": "Komplettes Back Office: CRM, Angebote, Rechnungen, E-Rechnung, Mahnwesen, Projekte, Zeiterfassung, Ausgaben, Dokumente, Website-Anfragen",
  "main": "src/server.js",
  "scripts": {
    "start": "node --no-warnings src/server.js",
    "dev": "node --no-warnings --watch src/server.js",
    "seed": "node --no-warnings src/db/seed.js",
    "test": "node --no-warnings --test tests/*.test.js",
    "backup": "node --no-warnings src/lib/backup-cli.js",
    "catalog": "node --no-warnings src/lib/catalog.js",
    "package": "bash deploy/package.sh"
  },
  "author": "Jörg Noack",
  "license": "UNLICENSED",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "ejs": "^3.1.10",
    "express": "^4.22.3",
    "helmet": "^8.3.0",
    "multer": "^2.5.0",
    "nodemailer": "^10.2.1",
    "pdfkit": "^0.20.2",
    "qrcode": "^1.5.4"
  },
  "private": true,
  "engines": {
    "node": ">=22.5"
  }
}
