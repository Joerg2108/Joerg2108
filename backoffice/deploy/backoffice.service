# systemd-Dienst (ohne Docker):  sudo cp deploy/backoffice.service /etc/systemd/system/ && sudo systemctl enable --now backoffice
[Unit]
Description=Back Office
After=network.target

[Service]
Type=simple
User=backoffice
WorkingDirectory=/opt/backoffice
ExecStart=/usr/bin/node --no-warnings src/server.js
Restart=always
RestartSec=5
EnvironmentFile=/opt/backoffice/.env
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
