# ─── Back Office – Konfiguration ───────────────────────────────
# Kopieren nach ".env" und anpassen.  NIEMALS .env ins Git einchecken!

NODE_ENV=production
PORT=3000
HOST=0.0.0.0
# Öffentliche Adresse des Back Office (für Links in Mails, iCal-Feed, Website-Formular)
BASE_URL=https://office.joerg-noack.com
# Hinter Nginx/Caddy/Traefik auf 1 setzen (korrekte IP-Adressen & Rate-Limits)
TRUST_PROXY=1

# Langer Zufallswert – erzeugen mit:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=BITTE_AENDERN
SESSION_DAYS=7

# Erster Administrator (wird nur beim allerersten Start angelegt)
ADMIN_EMAIL=info@joerg-noack.com
ADMIN_NAME=Jörg Noack
# Leer lassen = Zufallspasswort wird beim ersten Start im Log ausgegeben
ADMIN_PASSWORD=

# Website(s), die das Kontaktformular an das Back Office senden dürfen (kommagetrennt)
CORS_ORIGINS=https://joerg-noack.com,https://www.joerg-noack.com

# Datenablage (SQLite-Datenbank, Uploads, Backups)
DATA_DIR=./data
MAX_UPLOAD_MB=20
BACKUP_KEEP=30

# E-Mail-Versand (Rechnungen, Passwort-Reset, Benachrichtigungen)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=info@joerg-noack.com
SMTP_PASS=
SMTP_FROM="Jörg Noack <info@joerg-noack.com>"

# ─── Demo-Instanz für Interessenten (nur für eine separate Vorführ-Installation!) ───
# DEMO_MODE=1 legt bei jedem Start Musterdaten an und setzt sie regelmäßig zurück.
# ACHTUNG: Dabei wird die Datenbank in DATA_DIR gelöscht – niemals bei echten Daten aktivieren.
# DEMO_MODE=1
# DEMO_RESET_HOURS=6
# DEMO_CONTACT_URL=https://joerg-noack.com
# DEMO_VENDOR=Jörg Noack
