# Copy to .env.local (dev) or set in your host's dashboard (Vercel/Netlify).
# IMPORTANT: NEXT_PUBLIC_* values are baked in at BUILD time — redeploy after changing them.

# Production URL, no trailing slash. Used for canonical URLs, sitemap, robots and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://www.bushybaby-tikipub.com

# WhatsApp number that receives reservations: international format, digits only, no "+".
NEXT_PUBLIC_WHATSAPP_NUMBER=2547XXXXXXXX

# Let Google index the site — only once every [placeholder] is replaced with real data.
NEXT_PUBLIC_ALLOW_INDEXING=false
